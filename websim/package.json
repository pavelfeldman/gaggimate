{
  "name": "gaggimate-websim",
  "private": true,
  "type": "module",
  "description": "GaggiMate display and controller firmware compiled to WebAssembly, running against a simulated espresso machine in the browser.",
  "scripts": {
    "build": "wasm/build.sh && tsc -p .",
    "build:ts": "tsc -p .",
    "build:webui": "node scripts/build-webui.mjs",
    "watch": "tsc -p . --watch",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p . && node --test test/*.test.mjs",
    "start": "node scripts/serve.mjs",
    "publish:pages": "scripts/publish-pages.sh"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "three": "0.170.0"
  }
}
