{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": false,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": []
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
